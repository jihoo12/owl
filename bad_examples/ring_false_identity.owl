-- BAD: `add m n` and `mul m n` are not definitionally equal (and no ring
-- identity proves them equal), so `by ring` must fail to solve the goal
-- rather than produce a bogus proof.
-- Expected rejection: ring tactic unable to solve the goal.

import "../lib/ring_laws.owl"

def bad_false_identity : forall (m : Nat), forall (n : Nat),
    Path Nat (add m n) (mul m n) :=
  by intro m n; ring
