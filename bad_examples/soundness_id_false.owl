-- SOUNDNESS: Deriving False from Id types.
-- If we could construct an Id proof between distinct constructors,
-- we could derive Empty via elimination.
--
-- Expected rejection: type error (wrong endpoints).

inductive Nat where
  | zero : Nat
  | suc : Nat -> Nat

inductive Empty where

-- BAD: trying to return zero (a Nat) as Empty.
-- These are different types so this must fail.
def bad_id_false : Empty := zero
