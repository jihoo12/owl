-- SOUNDNESS: exhaustive match with all cases impossible on indexed type.
-- This file MUST fail to typecheck.
--
-- If Vec A (suc n) is matched with only `nil` (index zero), ALL cases
-- are impossible.  The kernel should reject this as non-exhaustive,
-- not silently produce a bogus value.

inductive Nat where
  | zero : Nat
  | suc : Nat -> Nat

inductive Vec (A : Type) (n : Nat) where
  | nil : Vec A zero
  | cons : A -> Vec A n -> Vec A (suc n)

-- BAD: matching Vec A (suc n) with only the nil case.
-- cons case is missing, nil is impossible (zero ≠ suc n).
-- This should be rejected.
def bad_empty : forall (A : Type), forall (n : Nat), Vec A (suc n) -> A :=
  fun A n v => match v return A with
  | nil => zero

def main : U1 := U0
