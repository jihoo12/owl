-- lib/reflection.owl — Reflection API for Owl (E1)
--
-- Provides the `OwlTerm` type (quoted ASTs), basic reflection operations,
-- and a TC monad for composing reflection with unification.
--
-- The kernel primitives are `quote_ast`, `unquote_ast`, `getContext_ast`,
-- `getType_ast`, and `unify_ast` (parsed as keywords).  This library wraps
-- them with user-friendly names.

import "logic.owl"

-- ═══════════════════════════════════════════════════════════════════
-- Quoted ASTs
-- ═══════════════════════════════════════════════════════════════════

-- The type of quoted ASTs.  Backed by the kernel's internal `Term`.
postulate OwlTerm : Type

-- Quote a term to its AST.
postulate quote : forall (A : Type), A -> OwlTerm

-- Unquote a quoted AST back into a term.
-- Requires a type annotation in infer mode.
postulate unquote : forall (A : Type), OwlTerm -> A

-- ═══════════════════════════════════════════════════════════════════
-- Context and type queries
-- ═══════════════════════════════════════════════════════════════════

-- Get the type of a term as a quoted AST.
postulate getType : forall (A : Type), A -> OwlTerm

-- Get the current typing context as a quoted AST.
postulate getContext : OwlTerm

-- ═══════════════════════════════════════════════════════════════════
-- TC monad and unification
-- ═══════════════════════════════════════════════════════════════════

-- The TC (type-checking) monad.  Computationally, `TC A` reduces to `A`
-- (identity monad), but at the type level it tracks reflection effects.
postulate TC : Type -> Type

-- Return a value in TC.
postulate tc_return : forall (A : Type), A -> TC A

-- Monadic bind for TC.
postulate tc_bind : forall (A : Type), forall (B : Type), TC A -> (A -> TC B) -> TC B

-- Unification: check that two terms are definitionally equal.
-- Returns Unit on success; type error on failure.
postulate unify : forall (A : Type), A -> A -> TC Unit

-- Guard: assert that a term has a given type.
postulate tc_guard : forall (A : Type), A -> TC Unit
