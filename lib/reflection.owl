-- lib/reflection.owl — Reflection API for Owl (E1)
--
-- Provides the `OwlTerm` type (quoted ASTs) and basic reflection operations.
-- The `OwlTerm` type is backed by the kernel's `TData("OwlTerm")` — it is
-- not an inductive type but a built-in representing quoted syntax.
--
-- The kernel primitives are `quote_ast` and `unquote_ast` (parsed as
-- keywords).  This library wraps them with friendlier names.

import "logic.owl"

-- The type of quoted ASTs.  This is a postulated type whose runtime
-- representation is the kernel's internal `Term` values.
postulate OwlTerm : Type

-- Quote a term to its AST.  `quote t` normalises `t` and returns the
-- result as a first-class `OwlTerm` value.
--
-- Usage:
--   quote (suc zero) : OwlTerm
--     evaluates to the quoted Nat representation.
postulate quote : forall (A : Type), A -> OwlTerm

-- Unquote a quoted AST back into a term.  `unquote ast` evaluates `ast`
-- (which must be a well-formed quoted term) and returns the result at the
-- expected type.
--
-- Usage:
--   let my_id : forall (A : Type), A -> A := unquote (quote (fun A x => x))
--
-- Note: `unquote` requires a type annotation in infer mode.  Use a let
-- binding or explicit type ascription: (unquote ast : A).
postulate unquote : forall (A : Type), OwlTerm -> A
