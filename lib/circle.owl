-- ────────────────────────────────────────────────────────────────────────
-- lib/circle.owl — The Circle S1 (G4)
-- ────────────────────────────────────────────────────────────────────────
--
-- The circle S1 is the fundamental higher inductive type in HoTT:
--   base : S1
--   loop : S1 [ base , base ]
--
-- The key theorem about S1 is that its fundamental group π₁(S¹) is
-- isomorphic to the integers Z.  In cubical type theory, this follows
-- from the fact that the loop space Ω(S1, base) = Path S1 base base
-- is generated by `loop`, and the universal cover of S1 is Z.

inductive S1 where
  | base : S1
  | loop : S1 [ base , base ]

-- The loop space of S1 at base.
def S1_loop_space : Type := Path S1 base base

-- The non-trivial loop.
def S1_loop : S1_loop_space := loop
