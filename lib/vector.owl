-- Vector (length-indexed list) library for Owl.
--
-- Provides a length-indexed list type with basic operations.
-- The Vec type is parameterized by element type A and length n : Nat.
-- Constructors: nil : Vec A zero, cons : A -> Vec A n -> Vec A (suc n).

inductive Nat where
  | zero : Nat
  | suc : Nat -> Nat

inductive Vec (A : Type) (n : Nat) where
  | nil : Vec A zero
  | cons : A -> Vec A n -> Vec A (suc n)

-- head: safe because n is suc _, so Vec is non-empty.
-- The nil branch is unreachable (zero ≠ suc n) by index unification.
def vhead : forall (A : Type), forall (n : Nat), A -> Vec A (suc n) -> A :=
  fun A n default v => match v return A with
  | nil => default
  | cons x xs => x

-- tail: safe because n is suc _, so Vec is non-empty.
-- The nil branch is unreachable (zero ≠ suc n) by index unification.
def vtail : forall (A : Type), forall (n : Nat), Vec A (suc n) -> Vec A n :=
  fun A n v => match v return Vec A n with
  | nil => nil
  | cons x xs => xs

def vnil : forall (A : Type), Vec A zero := fun (A : Type) => (nil : Vec A zero)

def vcons : forall (A : Type), forall (n : Nat), A -> Vec A n -> Vec A (suc n) :=
  fun A n x xs => cons x xs
