-- Experiment: Sign/magnitude Int encoding for tractable ring proofs
--
-- Int = (sign : Bool, mag : Nat) where
--   (false, n) = n
--   (true, n) = -n
--
-- This makes add/mul/associativity much simpler because we can just
-- do case analysis on signs and use Nat algebra.

-- Nat
inductive Nat where
  | zero : Nat
  | suc : Nat -> Nat

def nat_add : Nat -> Nat -> Nat := fun m n =>
  match m return Nat with
  | zero => n
  | suc m' => suc (nat_add m' n)

def nat_mul : Nat -> Nat -> Nat := fun m n =>
  match m return Nat with
  | zero => zero
  | suc m' => nat_add (nat_mul m' n) n

