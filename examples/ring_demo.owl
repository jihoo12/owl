import "ring_laws.owl"

def add_comm_demo : forall (m : Nat), forall (n : Nat), Path Nat (add m n) (add n m) :=
  by intro m n; ring

def mul_demo : forall (m : Nat), forall (n : Nat), Path Nat (mul m n) (mul n m) :=
  by intro m n; ring

def dist_demo : forall (m : Nat), forall (n : Nat), forall (p : Nat), Path Nat (mul (add m n) p) (add (mul m p) (mul n p)) :=
  by intro m n p; ring
