-- Indexed inductive type pattern matching demo.
-- Tests that index unification works for Vec elimination.

inductive Nat where
  | zero : Nat
  | suc : Nat -> Nat

inductive Vec (A : Type) (n : Nat) where
  | nil : Vec A zero
  | cons : A -> Vec A n -> Vec A (suc n)

-- vtail: drop the first element of a non-empty vector.
-- This requires index unification: matching cons x xs against Vec A (suc n)
-- must unify the constructor's index (suc n') with the scrutinee's index (suc n),
-- deriving n' = n so that xs : Vec A n.
def vtail : forall (A : Type), forall (n : Nat), Vec A (suc n) -> Vec A n :=
  fun A n v => match v return Vec A n with
  | nil => nil
  | cons x xs => xs

-- vcons: construct a vector by prepending
def vcons : forall (A : Type), forall (n : Nat), A -> Vec A n -> Vec A (suc n) :=
  fun A n x xs => cons x xs
